# ==================== SERVER & DOMAIN ====================
NODE_ENV=production
PORT=3000
APP_URL=https://pujajunction.com

# ==================== POSTGRESQL DATABASE ====================
# Option A (Recommended for Hostinger + Neon / Supabase / Render / VPS URL):
DATABASE_URL=
# Option B (Individual credentials if DATABASE_URL is not used):
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=pujajunction
SQL_SSL=false

# ==================== SECURITY & AUTH ====================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Email auto-promoted to Super Admin on login/registration
ADMIN_BOOTSTRAP_EMAIL=bksahani999@gmail.com
# Set to false on live production after creating your real admin account
SEED_DEMO_ACCOUNTS=false
# Optional: Only needed if you use Firebase Google Sign-In on a custom server
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==================== STORE DEFAULTS (Editable in Admin Panel) ====================
PUJA_WHATSAPP_NUMBER=919876543210
PUJA_UPI_ID=wahanilet@ptyes
PUJA_PAYEE_NAME=PujaJunction.com
